<mujoco model="g1_stick_push">

  <include file="g1_with_hand.xml"/>

  <compiler
    angle="radian"
    meshdir="meshes"/>

  <statistic center="0 0 0.5" extent="2.0"/>

  <option cone="elliptic" impratio="10"/>

  <default>
    <default class="g1">
      <position kp="1500" kv="100" forcerange="-80 80"/>
    </default>
  </default>

  <visual>
    <headlight
      diffuse="0.6 0.6 0.6"
      ambient="0.3 0.3 0.3"
      specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture
      type="skybox"
      builtin="gradient"
      rgb1="0.3 0.5 0.7"
      rgb2="0 0 0"
      width="512"
      height="3072"/>

    <texture
      type="2d"
      name="task_groundplane_tex"
      builtin="checker"
      mark="edge"
      rgb1="0.2 0.3 0.4"
      rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8"
      width="300"
      height="300"/>

    <material
      name="task_groundplane_mat"
      texture="task_groundplane_tex"
      texuniform="true"
      texrepeat="5 5"
      reflectance="0.2"/>
  </asset>

  <worldbody>

    <light
      pos="0 0 1.5"
      dir="0 0 -1"
      directional="true"/>

    <geom
      name="task_floor_geom"
      size="0 0 0.05"
      type="plane"
      material="task_groundplane_mat"/>

    <!-- Same table as Task 2. Top surface at z=0.85. -->
    <body name="table" pos="0.5 0 0.82">
      <geom
        name="table_top"
        type="box"
        size="0.40 0.40 0.03"
        rgba="0.55 0.35 0.20 1"/>

      <geom
        name="table_leg_fl"
        type="box"
        pos="0.35 0.35 -0.425"
        size="0.035 0.035 0.395"
        rgba="0.55 0.35 0.20 1"/>

      <geom
        name="table_leg_fr"
        type="box"
        pos="0.35 -0.35 -0.425"
        size="0.035 0.035 0.395"
        rgba="0.55 0.35 0.20 1"/>

      <geom
        name="table_leg_bl"
        type="box"
        pos="-0.35 0.35 -0.425"
        size="0.035 0.035 0.395"
        rgba="0.55 0.35 0.20 1"/>

      <geom
        name="table_leg_br"
        type="box"
        pos="-0.35 -0.35 -0.425"
        size="0.035 0.035 0.395"
        rgba="0.55 0.35 0.20 1"/>
    </body>

    <!-- Upright stick: 20 cm long, 3 cm diameter. Grabbed at mid-shaft. -->
    <body name="tool_stick" pos="0.40 0.26 0.950">
      <freejoint/>
      <geom
          name="tool_stick_geom"
          type="cylinder"
          size="0.015 0.10"
          mass="0.10"
          friction="1.2 0.08 0.01"
          condim="3"
          solref="0.02 1"
          solimp="0.9 0.95 0.001"
          rgba="0.55 0.35 0.15 1"/>
    </body>

    <!-- 8 cm cube: side face fully covers the 3 cm stick end at push height. -->
    <body name="obj_cube" pos="0.40 0.10 0.890">
      <freejoint/>
      <geom
        name="obj_cube_geom"
        type="box"
        size="0.04 0.04 0.04"
        mass="0.20"
        friction="1.0 0.05 0.01"
        condim="3"
        solref="0.02 1"
        solimp="0.9 0.95 0.000"
        rgba="1 0.45 0.1 1"/>
    </body>

    <!-- Flat 2D green region on the tabletop (0.6 mm), not a platform. -->
    <body name="green_target" pos="0.44 -0.12 0.8503">
      <geom
        name="green_target_geom"
        type="box"
        size="0.10 0.10 0.00005"
        rgba="0 1 0 0.45"
        friction="1.0 0.05 0.01"
        condim="3"/>
    </body>

  </worldbody>

  <equality>
    <weld
      name="pelvis_support"
      body1="pelvis"/>
  </equality>

</mujoco>
