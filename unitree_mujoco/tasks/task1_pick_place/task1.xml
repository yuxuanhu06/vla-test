<mujoco model="g1_pick_place">

  <include file="g1_with_hand.xml"/>

  <compiler
    angle="radian"
    meshdir="meshes"/>

  <statistic center="0 0 0.5" extent="2.0"/>

  <option cone="elliptic" impratio="10"/>

  <default>
    <!-- Unitree typically assigns 'arm' or 'torque' defaults. -->
    <!-- This converts them to stiff position actuators to stop sagging. -->
    <default class="g1">
      <position kp="1500" kv="100" forcerange="-80 80"/>
    </default>
  </default>

  <visual>
    <headlight
      diffuse="0.6 0.6 0.6"
      ambient="0.3 0.3 0.3"
      specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture
      type="skybox"
      builtin="gradient"
      rgb1="0.3 0.5 0.7"
      rgb2="0 0 0"
      width="512"
      height="3072"/>

    <texture
      type="2d"
      name="task_groundplane_tex"
      builtin="checker"
      mark="edge"
      rgb1="0.2 0.3 0.4"
      rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8"
      width="300"
      height="300"/>

    <material
      name="task_groundplane_mat"
      texture="task_groundplane_tex"
      texuniform="true"
      texrepeat="5 5"
      reflectance="0.2"/>
  </asset>

  <worldbody>

    <light
      pos="0 0 1.5"
      dir="0 0 -1"
      directional="true"/>

    <geom
      name="task_floor_geom"
      size="0 0 0.05"
      type="plane"
      material="task_groundplane_mat"/>

    <!-- Table. Top surface at z=0.85, which keeps the G1's reach to the -->
    <!-- work surface in the arm's comfortable mid-range: the shoulder sits -->
    <!-- at z=1.085 and the arm spans 0.468 m, so a lower top forces the arm -->
    <!-- to work at the edge of its workspace in a contorted posture. -->
    <body name="table" pos="0.5 0 0.82">
      <geom
        name="table_top"
        type="box"
        size="0.40 0.40 0.03"
        rgba="0.55 0.35 0.20 1"/>
    
    <!-- Front-left leg -->
      <geom
        name="table_leg_fl"
        type="box"
        pos="0.35 0.35 -0.425"
        size="0.035 0.035 0.395"
        rgba="0.55 0.35 0.20 1"/>

  <!-- Front-right leg -->
      <geom
        name="table_leg_fr"
        type="box"
        pos="0.35 -0.35 -0.425"
        size="0.035 0.035 0.395"
        rgba="0.55 0.35 0.20 1"/>

  <!-- Back-left leg -->
      <geom
        name="table_leg_bl"
        type="box"
        pos="-0.35 0.35 -0.425"
        size="0.035 0.035 0.395"
        rgba="0.55 0.35 0.20 1"/>

  <!-- Back-right leg -->
      <geom
        name="table_leg_br"
        type="box"
        pos="-0.35 -0.35 -0.425"
        size="0.035 0.035 0.395"
        rgba="0.55 0.35 0.20 1"/>

    </body>

    <!-- Red block, 2.8 cm square and 11 cm tall. The width is set by the Dex3
         jaw, which only opens about 2.8 cm between the thumb pad and the
         index/middle pads. The height matters just as much: the fingers reach
         0.08 m below the palm, so the grasp point has to sit at least ~0.055 m
         above the table or the open fingers stand on it and block the descent.
         An upright block puts the grasp point high enough while the object
         still rests on the table. -->
    <body name="red_cube" pos="0.34 0.26 0.906">
      <freejoint/>

      <geom
        name="red_cube_geom"
        type="box"
        size="0.011 0.011 0.055"
        mass="0.08"
        friction="1.2 0.05 0.01"
        condim="3"
        solref="0.02 1"
        solimp="0.9 0.95 0.001"
        rgba="1 0 0 1"/>
    </body>

    <!-- Green target -->
    <body name="green_target" pos="0.31 0.08 0.855">
      <geom
        name="green_target_geom"
        type="box"
        size="0.10 0.10 0.005"
        rgba="0 1 0 0.5"
        contype="0"
        conaffinity="0"/>
    </body>

  </worldbody>

  <equality>

    <weld
    name="pelvis_support"
    body1="pelvis"/>

  </equality>

</mujoco>
