      type="skybox"
      builtin="gradient"
      rgb1="0.3 0.5 0.7"
      rgb2="0 0 0"
      width="512"
      height="3072"/>

    <texture
      type="2d"
      name="task_groundplane_tex"
      builtin="checker"
      mark="edge"
      rgb1="0.2 0.3 0.4"
      rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8"
      width="300"
      height="300"/>

    <texture
      type="2d"
      name="table_checker_tex"
      builtin="checker"
      rgb1="0.45 0.30 0.18"
      rgb2="0.62 0.42 0.24"
      width="256"
      height="256"/>

    <texture
      type="2d"
      name="table_wood_tex"
      file="table_wood.png"/>

    <material
      name="task_groundplane_mat"
      texture="task_groundplane_tex"
      texuniform="true"
      texrepeat="5 5"
      reflectance="0.2"/>

    <material
      name="table_png_mat"
      texture="table_wood_tex"
      texuniform="true"
      texrepeat="2 2"
      reflectance="0.1"
      rgba="0.55 0.35 0.20 1"/>

    <material
