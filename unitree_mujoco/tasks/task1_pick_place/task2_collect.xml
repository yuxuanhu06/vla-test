<mujoco model="g1_pick_by_type_collect">

  <include file="g1_with_hand.xml"/>

  <compiler
    angle="radian"
    meshdir="meshes"
    texturedir="data_collection/assets"/>

  <statistic center="0 0 0.5" extent="2.0"/>

  <option cone="elliptic" impratio="10"/>

  <default>
    <default class="g1">
      <position kp="1500" kv="100" forcerange="-80 80"/>
    </default>
  </default>

  <visual>
    <headlight
      diffuse="0.6 0.6 0.6"
      ambient="0.3 0.3 0.3"
      specular="0 0 0"/>
